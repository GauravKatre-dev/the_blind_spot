# Environment configuration for Blind Spot
# IMPORTANT: Never commit actual API keys or secrets to version control.

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# Application Environment
NODE_ENV=development
PORT=3000

# Optional Persistence (Firebase / Firestore)
# FIREBASE_PROJECT_ID=blind-spot-510606
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
